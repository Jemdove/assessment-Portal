# Make a copy of this file, name the copy ".env", and fill it in.

# The Gmail account the portal sends emails FROM
# (account confirmations, password resets, "scores received" notices).
# Best to create a new Gmail just for the school portal.
EMAIL_USER=schoolportal077@gmail.com

# A Gmail "App password" (16 letters), NOT your normal Gmail password.
# Get one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be switched on first)
EMAIL_PASS=kpfh uyzb wbxe xtyv

# The address teachers use to open the portal (used inside email links).
# Change this when the portal is put online.
APP_URL=http://localhost:3000

# Any long random text. Keeps sign-ins safe.
SESSION_SECRET=change-this-to-any-long-random-text